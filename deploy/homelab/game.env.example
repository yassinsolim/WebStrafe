# copy to /etc/webstrafe/game.env
NODE_ENV=production
# only cloudflared on the same vm talks to this port
HOST=127.0.0.1
PORT=8080
ENABLE_BOTS=true
BOTS_PER_MAP=2
SNAPSHOT_RATE_HZ=30
# cloudflare sets CF-Connecting-IP; don't trust X-Forwarded-For
TRUST_PROXY=cloudflare
WEBSTRAFE_DATA_DIR=/var/lib/webstrafe
WEBSTRAFE_ALLOWED_ORIGINS=https://strafe.yassin.app
WEBSTRAFE_ALLOWED_ORIGIN_SUFFIXES=-yassins-projects-11732a5e.vercel.app
