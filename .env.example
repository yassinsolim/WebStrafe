# WebStrafe environment variables (all optional for local single-origin dev).
#
# --- Client build (Vite; only VITE_-prefixed vars reach the browser) ---
# Enable the combat/bots client (HUD, firing, tracers). Off by default.
VITE_ENABLE_COMBAT=true
# Split deploy only: point the static client at the backend. Leave unset for a
# single-origin deploy (server serves the client) or local dev (uses the proxy).
# VITE_WS_URL=wss://webstrafe-server.fly.dev/ws
# VITE_API_BASE=https://webstrafe-server.fly.dev
#
# --- Server runtime ---
# PORT=8787
# HOST=0.0.0.0
# NODE_ENV=production
# Spawn server-side bots (per map). Off by default.
ENABLE_BOTS=true
BOTS_PER_MAP=2
# Comma-separated origins allowed to open the WS/API (production hardening).
# WEBSTRAFE_ALLOWED_ORIGINS=https://strafe.yassin.app
# Directory for the persisted leaderboard (mount a volume here in production).
# WEBSTRAFE_DATA_DIR=/data
